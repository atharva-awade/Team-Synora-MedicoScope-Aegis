  "claimExtraction": {
    "bareNumberLabels": [
      "haemoglobin",
      "hemoglobin",
      "hba1c",
      "glucose",
      "spo2",
      "oxygen saturation",
      "systolic",
      "diastolic",
      "heart rate",
      "pulse rate",
      "bmi",
      "creatinine",
      "cholesterol",
      "ldl",
      "hdl",
      "triglycerides",
      "platelet",
      "wbc",
      "rbc",
      "tsh",
      "jitter",
      "shimmer",
      "hnr",
      "respiratory rate",
      "temperature"
    ],
    "ignorePatterns": [
      "\\bQG-[A-Z0-9.\\-]+\\b",
      "\\b[A-Z0-9]{5}-[A-Z0-9]{5}\\b",
      "\\bv?\\d+\\.\\d+\\.\\d+\\b",
      "\\bgrade\\s+\\d+(?:\\.\\d+)?\\b",
      "\\b\\d+\\s*(?:of|/)\\s*\\d+\\s*(?:dimension|check|point)s?\\b",
      "\\b(?:dimension|check|point|step)\\s+\\d+\\b"
    ],
    "tolerances": {
      "mmHg": 2,
      "%": 1,
      "bpm": 2,
      "mg/dL": 2,
      "g/dL": 0.2,
      "mmol/L": 0.2,
      "degC": 0.2,
      "kg": 0.5,
      "_relative": 0.02
    },
