{
  "packId": "medical",
  "packVersion": "3.0.0",
  "engine": "3.x",
  "title": "MedicoScope Clinical Screening Content Policy",
  "description": "Domain policy for the Aegis Quality Gate. The ENGINE is domain-neutral; this file is the medical opinion. Fork it, keep the engine, and the same gate certifies a different field.",
  "locale": "en",
  "defaultProfile": "patient_report",
  "authors": [
    "Team Synora"
  ],
  "changelog": [
    {
      "version": "3.0.0",
      "note": "First rules-as-data pack. Adds evidence binding, fidelity overclaim detection, real Flesch-Kincaid, scope guard, and profile overrides."
    }
  ],
  "dimensions": [
    {
      "id": "structure",
      "title": "Structure & Completeness",
      "weight": 1.0,
      "intent": "Every field a reader needs to act is present, and nothing is a leftover from generation."
    },
    {
      "id": "readability",
      "title": "Readability & Accessibility",
      "weight": 1.2,
      "intent": "The reader can actually understand it at their reading level, with jargon glossed."
    },
    {
      "id": "safety",
      "title": "Clinical Safety & Scope",
      "weight": 1.5,
      "intent": "Escalation where risk demands it, no false certainty, and never steps outside screening scope."
    },
    {
      "id": "actionability",
      "title": "Actionability",
      "weight": 1.0,
      "intent": "A named actor, a concrete next step, and a deadline."
    },
    {
      "id": "grounding",
      "title": "Evidence Grounding",
      "weight": 1.6,
      "intent": "Every number in the prose traces to evidence the system actually holds, at the fidelity it actually has."
    }
  ],
